# Entorno LOCAL de desarrollo (dummy, solo para levantar Swagger UI sin PostgreSQL/Redis reales).
# NUNCA usar estos valores en produccion. No commitear este archivo (ver .gitignore).

# PostgreSQL (docker compose levantado en puerto alternativo 5433, ver Analitycs/docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=anti_procrastinacion
POSTGRES_USER=analytics_user
POSTGRES_PASSWORD=changeme

# Redis (docker compose levantado en puerto alternativo 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# Entorno / Swagger (FR-032)
ENVIRONMENT=development

# Autenticacion de administrador (FR-020) — usuario: admin / password: Admin12345
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$QjSwx0WpdMSXtA0.y3t2lO3zf8FslN7ZcZrdM8fI806uGY5sUu1T.

# Login de prueba EXCLUSIVO para Swagger (FR-031) — usuario: tester / password: Tester12345
TEST_ADMIN_USER=tester
TEST_ADMIN_PASSWORD=Tester12345

# Zona horaria por defecto si el cliente no envia X-Client-Timezone.
DEFAULT_CLIENT_TIMEZONE=UTC

# Secreto compartido para el endpoint interno de invalidacion de cache (llamado por el ETL).
ETL_CACHE_INVALIDATION_SECRET=dev-only-secret-cambiar-en-produccion
