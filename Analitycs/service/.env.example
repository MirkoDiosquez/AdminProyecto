# Copiar a `.env` y completar con valores reales. NUNCA commitear `.env` con datos reales.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=anti_procrastinacion
POSTGRES_USER=analytics_user
POSTGRES_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Entorno / Swagger (FR-032). development|qa habilitan Swagger UI; cualquier otro valor lo oculta.
ENVIRONMENT=development

# Autenticacion de administrador (FR-020) — NUNCA hardcodear en codigo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Login de prueba EXCLUSIVO para Swagger (FR-031) — separado del anterior.
TEST_ADMIN_USER=
TEST_ADMIN_PASSWORD=

# Zona horaria por defecto si el cliente no envia X-Client-Timezone.
DEFAULT_CLIENT_TIMEZONE=UTC

# Secreto compartido para el endpoint interno de invalidacion de cache (llamado por el ETL).
ETL_CACHE_INVALIDATION_SECRET=
